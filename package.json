{
  "name": "playwright-qa-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "QA automation portfolio: Playwright + TypeScript suite for the Practice Software Testing (Toolshop) app",
  "license": "MIT",
  "author": "Pablo Enrique Silva Solano",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e-*",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=a11y",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
